rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // TapSlip shared data for a single restaurant (rid = 'tapslip').
    // The customer app and the owner web admin both read/write these
    // collections in real time:
    //   settings/{rid}/config/{docId}     name, gstPercent, isOpen, address
    //   menu/{rid}/items/{docId}          dishes (admin add/edit/delete)
    //   offers/{rid}/items/{docId}
    //   charges/{rid}/items/{docId}
    //   employees/{rid}/items/{docId}
    //   orders/{rid}/items/{docId}        placed by the app, status set by admin
    //   tables/{rid}/items/{docId}        floor layout (admin only)
    //   customers/{rid}/items/{docId}     (admin only)
    //   inventory/{rid}/items/{docId}     (admin only)
    //
    // NOTE: neither client signs in yet (customer app is anonymous, the owner
    // panel uses a local PIN), so these rules allow public access scoped to
    // this restaurant's collections. Before launch, add Firebase Auth and
    // tighten to e.g. `request.auth != null` for writes.
    match /settings/{rid}/config/{docId} {
      allow read, write: if rid == 'tapslip';
    }

    match /{collection}/{rid}/items/{docId} {
      allow read, write: if rid == 'tapslip' && collection in [
        'menu', 'offers', 'charges', 'employees', 'orders',
        'tables', 'customers', 'inventory'
      ];
    }
  }
}
